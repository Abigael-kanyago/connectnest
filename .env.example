# Supabase Configuration for ConnectNest
# Replace these with your actual Supabase project URL and anon public key from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for backend administration tasks (Never expose in browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
